# Copie este archivo como .env y reemplace los valores. Nunca suba .env al repositorio.

# Base de datos de desarrollo (PostgreSQL 17)
DATABASE_URL=postgresql+psycopg://postgres:SU_CLAVE@localhost:5432/taller_dev

# Base de datos exclusiva para pytest: las pruebas la vacían en cada ejecución
TEST_DATABASE_URL=postgresql+psycopg://postgres:SU_CLAVE@localhost:5432/taller_test

# Clave para firmar las sesiones (mínimo 32 caracteres). Genere una con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# desarrollo | produccion  (en produccion la cookie de sesión exige HTTPS)
ENTORNO=desarrollo

# URL pública desde la que se abre el sistema (se usa en los enlaces de seguimiento)
ORIGEN_PUBLICO=http://localhost:5173
